{
  "name": "@moneko/eslint",
  "version": "1.11.2",
  "type": "module",
  "description": "eslint",
  "main": "lib/index.mjs",
  "scripts": {
    "prebuild": "rollup --config rollup.dts.mjs",
    "build": "rollup -c && rollup --config rollup.cjs.mjs",
    "postbuild": "rollup --config rollup.formatters.mjs",
    "test": "node ./test.mjs && node ./test.cjs",
    "prepublishOnly": "yarn build"
  },
  "keywords": [
    "eslint-config-neko",
    "eslint"
  ],
  "author": "moneko",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./cjs/index.cjs"
    },
    "./base": {
      "import": "./lib/base.mjs",
      "require": "./cjs/base.cjs"
    },
    "./react": {
      "import": "./lib/react.mjs",
      "require": "./cjs/react.cjs"
    },
    "./react-jsx": {
      "import": "./lib/react-jsx.mjs",
      "require": "./cjs/react-jsx.cjs"
    },
    "./react-legacy": {
      "import": "./lib/react-legacy.mjs",
      "require": "./cjs/react-legacy.cjs"
    },
    "./solid": {
      "import": "./lib/solid.mjs",
      "require": "./cjs/solid.cjs"
    },
    "./vue": {
      "import": "./lib/vue.mjs",
      "require": "./cjs/vue.cjs"
    },
    "./react-compiler": {
      "import": "./lib/react-compiler.mjs",
      "require": "./cjs/react-compiler.cjs"
    },
    "./babel-core": {
      "import": "./lib/babel-core.mjs",
      "require": "./cjs/babel-core.cjs"
    },
    "./babel-parser": {
      "import": "./lib/babel-parser.mjs",
      "require": "./cjs/babel-parser.cjs"
    },
    "./babel-typescript": {
      "import": "./lib/babel-typescript.mjs",
      "require": "./cjs/babel-typescript.cjs"
    },
    "./babel-preset-env": {
      "import": "./lib/babel-preset-env.mjs",
      "require": "./cjs/babel-preset-env.cjs"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "@babel/preset-typescript": "7.28.5",
    "@rollup/plugin-alias": "6.0.0",
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/babel__core": "7.20.5",
    "@types/node": "25.5.0",
    "babel-plugin-fbt": "1.0.0",
    "babel-plugin-fbt-runtime": "1.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "core-js": "3.49.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-hooks-5": "npm:eslint-plugin-react-hooks@5.2.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-solid": "0.14.5",
    "eslint-plugin-vue": "10.8.0",
    "globals": "17.4.0",
    "jiti": "2.6.1",
    "prettier": "3.8.1",
    "rollup": "4.59.0",
    "rollup-plugin-dts": "6.4.0",
    "rollup-plugin-node-externals": "8.1.2",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vue-eslint-parser": "10.4.0"
  },
  "files": [
    "lib",
    "cjs"
  ],
  "packageManager": "yarn@1.22.22"
}
